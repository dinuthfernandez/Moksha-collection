# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file — it is gitignored.

# --- Supabase (see project settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SCHEMA=moksha_collection
SUPABASE_DB_PASSWORD=replace-with-db-password

# --- Auth (generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=20160

# --- Admin panel (shared login, no per-admin accounts) ---
ADMIN_PASSWORD=admin
ADMIN_JWT_EXPIRES_MINUTES=720

# --- Zoho Mail OAuth: info@ transactional emails ---
# Required scopes: ZohoMail.accounts.READ,ZohoMail.messages.CREATE
INFO_ZOHO_CLIENT_ID=replace-with-mail-client-id
INFO_ZOHO_CLIENT_SECRET=replace-with-mail-client-secret
INFO_ZOHO_REFRESH_TOKEN=replace-with-mail-refresh-token
INFO_ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
INFO_ZOHO_MAIL_API_URL=https://mail.zoho.com
INFO_ZOHO_FROM_EMAIL=info@yourdomain.com

# --- Zoho Mail OAuth: sales@ order emails and admin campaigns ---
# Required scopes: ZohoMail.accounts.READ,ZohoMail.messages.CREATE
SALES_ZOHO_CLIENT_ID=replace-with-mail-client-id
SALES_ZOHO_CLIENT_SECRET=replace-with-mail-client-secret
SALES_ZOHO_REFRESH_TOKEN=replace-with-mail-refresh-token
SALES_ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
SALES_ZOHO_MAIL_API_URL=https://mail.zoho.com
SALES_ZOHO_FROM_EMAIL=sales@yourdomain.com

PASSWORD_RESET_CODE_EXPIRES_MINUTES=15

# --- Zoho Inventory sync ---
ZOHO_CLIENT_ID=replace-with-client-id
ZOHO_CLIENT_SECRET=replace-with-client-secret
ZOHO_REFRESH_TOKEN=replace-with-refresh-token
ZOHO_ORGANIZATION_ID=replace-with-organization-id
ZOHO_INVENTORY_SYNC_INTERVAL_SECONDS=3600
ZOHO_OFFLINE_SALE_WEBHOOK_SECRET=generate-a-long-random-secret

# --- App ---
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
