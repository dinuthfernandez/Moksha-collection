# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file — it is gitignored.

# --- Supabase (see project settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SCHEMA=moksha_collection
SUPABASE_DB_PASSWORD=replace-with-db-password

# --- Auth (generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=20160

# --- App ---
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
