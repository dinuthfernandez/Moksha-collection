# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file — it is gitignored.

# --- Supabase (see project settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SCHEMA=moksha_collection
SUPABASE_DB_PASSWORD=replace-with-db-password

# --- Auth (generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=20160

# --- Admin panel (shared login, no per-admin accounts) ---
ADMIN_PASSWORD=admin
ADMIN_JWT_EXPIRES_MINUTES=720

# --- SMTP: info@ (welcome email, password reset code, password reset confirmation) ---
INFO_SMTP_HOST=smtp.zoho.com
INFO_SMTP_PORT=587
INFO_SMTP_USERNAME=info@yourdomain.com
INFO_SMTP_PASSWORD=replace-with-mailbox-password
INFO_SMTP_FROM_EMAIL=info@yourdomain.com
INFO_SMTP_FROM_NAME=Moksha Collections

# --- SMTP: sales@ (order placed/completed emails + admin Campaigns page) ---
SALES_SMTP_HOST=smtp.zoho.com
SALES_SMTP_PORT=587
SALES_SMTP_USERNAME=sales@yourdomain.com
SALES_SMTP_PASSWORD=replace-with-mailbox-password
SALES_SMTP_FROM_EMAIL=sales@yourdomain.com
SALES_SMTP_FROM_NAME=Moksha Collections

PASSWORD_RESET_CODE_EXPIRES_MINUTES=15

# --- Zoho Inventory sync ---
ZOHO_CLIENT_ID=replace-with-client-id
ZOHO_CLIENT_SECRET=replace-with-client-secret
ZOHO_REFRESH_TOKEN=replace-with-refresh-token
ZOHO_ORGANIZATION_ID=replace-with-organization-id
ZOHO_INVENTORY_SYNC_INTERVAL_SECONDS=3600

# --- App ---
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
